APP_NAME=NTCSWEB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5299
APP_URL_SCHEME=http

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Multi-tenancy: hostnames that are the platform itself, never a school, plus
# the domain every school gets a subdomain under. See config/tenancy.php.
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1,admin.ntcsweb.com
TENANCY_ROOT_DOMAIN=ntcsweb.com
TENANCY_ALLOW_REQUEST_RESOLUTION=true
TENANCY_AUTH_GUARD=sanctum
TENANCY_CACHE_TTL=300

RBAC_CACHE_TTL=900

# Comma-separated first-party SPA origins that receive session-cookie auth.
# *.ntcsweb.com is covered separately via config/cors.php's origin pattern.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5299,127.0.0.1,127.0.0.1:5299,localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5299,http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ntcsdb
DB_USERNAME=ntcsuser
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=ntcsweb_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage (AWS S3, Cloudflare R2). Files are namespaced per
# tenant under tenants/{tenant_id}/... regardless of which disk is active —
# see Tenant::storagePath().
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional — invoice notifications degrade to "not configured" (a FAILED
# NotificationLog row, not an error) when this is blank. Get one from
# @BotFather on Telegram. See App\Services\Billing\Notifications\TelegramChannel.
TELEGRAM_BOT_TOKEN=

VITE_APP_NAME="${APP_NAME}"
